# Supabase project URL and publishable key. This public key is safe for the SSR client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older Supabase projects can use their legacy anon key instead, if needed.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only keys for payment/video providers are added after merchant onboarding.
# Never prefix secrets with NEXT_PUBLIC_.
CF_STREAM_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_CUSTOMER_CODE=

FIB_BASE_URL=https://fib.stage.fib.iq
FIB_CLIENT_ID=
FIB_CLIENT_SECRET=
FIB_MERCHANT_ID=

QICARD_BASE_URL=https://uat-sandbox-3ds-api.qi.iq/api/v1
QICARD_TERMINAL_ID=
QICARD_USERNAME=
QICARD_PASSWORD=
QICARD_WEBHOOK_SECRET=

# FastPay Iraq merchant API availability and credentials must be confirmed directly.
FASTPAY_BASE_URL=
FASTPAY_MERCHANT_ID=
FASTPAY_SECRET_KEY=

SITE_URL=http://localhost:3123
